# Copy to .env.local for local work; set production secrets in the hosting dashboard.
# Never reuse the old GCV database, JWT secret, encryption key, or Google refresh token.
DATABASE_URL=mysql://EXAMPLE_USER@EXAMPLE_HOST.invalid:3306/agenda_ufb
JWT_SECRET=CHANGE_ME
APP_ID=agenda-ufb-pilot
PUBLIC_APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:3000
GMAIL_USER=giovane.bono77@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 64 random hexadecimal characters (a new key for this pilot).
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional: use a separate calendar for this pilot; leave empty to disable synchronization.
GOOGLE_CALENDAR_ID=

# Piloto UFB: notificacoes desativadas
UFB_EMAIL_NOTIFICATIONS_ENABLED=false
